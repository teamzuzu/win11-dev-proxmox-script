<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
    <settings pass="windowsPE">
        <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
            <SetupUILanguage>
                <UILanguage>en-GB</UILanguage>
            </SetupUILanguage>
            <InputLocale>en-GB</InputLocale>
            <SystemLocale>en-GB</SystemLocale>
            <UILanguage>en-GB</UILanguage>
            <UserLocale>en-GB</UserLocale>
        </component>
        <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
            <DiskConfiguration>
                <Disk wcm:action="add">
                    <DiskID>0</DiskID>
                    <WillWipeDisk>true</WillWipeDisk>
                    <CreatePartitions>
                        <CreatePartition wcm:action="add">
                            <Order>1</Order>
                            <Type>EFI</Type>
                            <Size>100</Size>
                        </CreatePartition>
                        <CreatePartition wcm:action="add">
                            <Order>2</Order>
                            <Type>MSR</Type>
                            <Size>16</Size>
                        </CreatePartition>
                        <CreatePartition wcm:action="add">
                            <Order>3</Order>
                            <Type>Primary</Type>
                            <Extend>true</Extend>
                        </CreatePartition>
                    </CreatePartitions>
                    <ModifyPartitions>
                        <ModifyPartition wcm:action="add">
                            <Order>1</Order>
                            <PartitionID>1</PartitionID>
                            <Format>FAT32</Format>
                            <Label>System</Label>
                        </ModifyPartition>
                        <ModifyPartition wcm:action="add">
                            <Order>2</Order>
                            <PartitionID>2</PartitionID>
                        </ModifyPartition>
                        <ModifyPartition wcm:action="add">
                            <Order>3</Order>
                            <PartitionID>3</PartitionID>
                            <Format>NTFS</Format>
                            <Label>Windows</Label>
                            <Letter>C</Letter>
                        </ModifyPartition>
                    </ModifyPartitions>
                </Disk>
            </DiskConfiguration>
            <ImageInstall>
                <OSImage>
                    <InstallTo>
                        <DiskID>0</DiskID>
                        <PartitionID>3</PartitionID>
                    </InstallTo>
                </OSImage>
            </ImageInstall>
            <UserData>
                <AcceptEula>true</AcceptEula>
                <ProductKey>
                    <Key>VK7JG-NPHTM-C97JM-9MPGT-3V66T</Key>
                </ProductKey>
            </UserData>
        </component>
        <component name="Microsoft-Windows-PnpCustomizationsWinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
            <!--
                Drive letters D:-H: cover WinPE's shifting CD-ROM assignment.
                vioscsi (not viostor) matches win11.sh's virtio-scsi-pci
                controller - see CLAUDE.md.
            -->
            <DriverPaths>
                <PathAndCredentials wcm:action="add" wcm:keyValue="1">
                    <Path>D:\vioscsi\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="2">
                    <Path>E:\vioscsi\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="3">
                    <Path>F:\vioscsi\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="4">
                    <Path>G:\vioscsi\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="5">
                    <Path>H:\vioscsi\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="6">
                    <Path>D:\NetKVM\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="7">
                    <Path>E:\NetKVM\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="8">
                    <Path>F:\NetKVM\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="9">
                    <Path>G:\NetKVM\w11\amd64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="10">
                    <Path>H:\NetKVM\w11\amd64</Path>
                </PathAndCredentials>
            </DriverPaths>
        </component>
    </settings>

    <settings pass="specialize">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
            <ComputerName>*</ComputerName> </component>
        <!-- Sets the installed OS's locale (the -WinPE component above only
             covers Setup's own UI language) - see CLAUDE.md. -->
        <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
            <InputLocale>en-GB</InputLocale>
            <SystemLocale>en-GB</SystemLocale>
            <UILanguage>en-GB</UILanguage>
            <UserLocale>en-GB</UserLocale>
        </component>
        <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
            <RunSynchronous>
                <RunSynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Path>reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" /v BypassNRO /t REG_DWORD /d 1 /f</Path>
                    <Description>Bypass MSA Requirement</Description>
                </RunSynchronousCommand>
                <!-- Do NOT add anything else here. Two separate attempts at a second
                     RunSynchronousCommand in this pass (a DISM/Appx-based Outlook removal,
                     then a "registry-only" one) both crashed Windows Setup with "the
                     computer restarted unexpectedly" - see CLAUDE.md before trying again -->
            </RunSynchronous>
        </component>
    </settings>

    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <HideLocalAccountScreen>true</HideLocalAccountScreen>
                <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
                <NetworkLocation>Home</NetworkLocation>
                <ProtectYourPC>3</ProtectYourPC>
            </OOBE>
            <UserAccounts>
                <LocalAccounts>
                    <LocalAccount wcm:action="add">
                        <Name>Admin</Name>
                        <Group>Administrators</Group>
                        <Password>
                            <Value>PASSWORD_PLACEHOLDER</Value>
                            <PlainText>true</PlainText>
                        </Password>
                    </LocalAccount>
                </LocalAccounts>
            </UserAccounts>
            <AutoLogon>
                <Password>
                    <Value>PASSWORD_PLACEHOLDER</Value>
                    <PlainText>true</PlainText>
                </Password>
                <Enabled>true</Enabled>
                <LogonCount>999</LogonCount>
                <Username>Admin</Username>
            </AutoLogon>
            <FirstLogonCommands>
                <!-- Debloat: Disable Telemetry -->
                <SynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Description>Disable Telemetry</Description>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v AllowTelemetry /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>
                <!-- Debloat: Disable Consumer Features (Bloat) -->
                <SynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <Description>Disable Consumer Features</Description>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" /v DisableWindowsConsumerFeatures /t REG_DWORD /d 1 /f</CommandLine>
                </SynchronousCommand>
                <!-- Debloat: Disable Search Suggestions -->
                <SynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <Description>Disable Search Suggestions</Description>
                    <CommandLine>reg add "HKCU\Software\Policies\Microsoft\Windows\Explorer" /v DisableSearchBoxSuggestions /t REG_DWORD /d 1 /f</CommandLine>
                </SynchronousCommand>
                <!-- Debloat: Disable Widgets -->
                <SynchronousCommand wcm:action="add">
                    <Order>4</Order>
                    <Description>Disable Widgets</Description>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Dsh" /v AllowNewsAndInterests /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>
                <!-- Debloat: Disable Start Menu/Settings suggestion ads -->
                <SynchronousCommand wcm:action="add">
                    <Order>5</Order>
                    <Description>Disable Start Suggestions</Description>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" /v DisableSoftLanding /t REG_DWORD /d 1 /f</CommandLine>
                </SynchronousCommand>
                <!-- Debloat: Disable Xbox Game Bar/GameDVR - avoids overlay/capture hooking
                     into the recompiled game's D3D11 output, see CLAUDE.md -->
                <SynchronousCommand wcm:action="add">
                    <Order>6</Order>
                    <Description>Disable Game Bar</Description>
                    <CommandLine>reg add "HKCU\System\GameConfigStore" /v GameDVR_Enabled /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>7</Order>
                    <Description>Disable Game DVR Policy</Description>
                    <CommandLine>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\GameDVR" /v AllowGameDVR /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>

                <!-- Deprovision "new Outlook" - Windows Update Orchestrator has a dedicated
                     OOBE-time task (UScheduler_Oobe\OutlookUpdate) that installs it from the
                     Store, the likely source of an unexpected region/market prompt during
                     setup. This used to run in the specialize pass to try to beat that task,
                     but Remove-AppxProvisionedPackage there collided with Setup's own
                     concurrent servicing and crashed the install ("computer restarted
                     unexpectedly") - moved here instead, see CLAUDE.md -->
                <SynchronousCommand wcm:action="add">
                    <Order>8</Order>
                    <Description>Deprovision new Outlook for Windows</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-AppxProvisionedPackage -Online | Where-Object { $_.PackageName -like 'Microsoft.OutlookForWindows*' } | Remove-AppxProvisionedPackage -Online; Remove-Item -Path 'HKLM:\SOFTWARE\Microsoft\WindowsUpdate\Orchestrator\UScheduler_Oobe\OutlookUpdate' -Force -ErrorAction SilentlyContinue"</CommandLine>
                </SynchronousCommand>

                <!-- Install QEMU Guest Agent from the VirtIO ISO (ide3) so Proxmox's
                     qm agent option actually has something to talk to - see CLAUDE.md
                     for why the drive letter is searched for rather than hardcoded -->
                <SynchronousCommand wcm:action="add">
                    <Order>9</Order>
                    <Description>Install QEMU Guest Agent</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "$msi = Get-WmiObject Win32_CDROMDrive | ForEach-Object { Join-Path $_.Drive 'guest-agent\qemu-ga-x64.msi' } | Where-Object { Test-Path $_ } | Select-Object -First 1; if ($msi) { Start-Process msiexec.exe -ArgumentList @('/i', $msi, '/quiet', '/norestart') -Wait }"</CommandLine>
                </SynchronousCommand>

                <!-- Network: force Private category (NetworkLocation in OOBE above isn't
                     always honored reliably - see CLAUDE.md) so SSH/RDP aren't blocked by
                     the Public-profile firewall defaults -->
                <SynchronousCommand wcm:action="add">
                    <Order>10</Order>
                    <Description>Force network category to Private</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private"</CommandLine>
                </SynchronousCommand>
                <!-- Firewall fully disabled per user request - dev/lab VM only, see CLAUDE.md -->
                <SynchronousCommand wcm:action="add">
                    <Order>11</Order>
                    <Description>Disable Windows Firewall (all profiles)</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled False"</CommandLine>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>12</Order>
                    <Description>Enable Remote Desktop</Description>
                    <CommandLine>reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" /v fDenyTSConnections /t REG_DWORD /d 0 /f</CommandLine>
                </SynchronousCommand>
                <!-- Redundant with the firewall being disabled, kept in case it's re-enabled later -->
                <SynchronousCommand wcm:action="add">
                    <Order>13</Order>
                    <Description>Allow Remote Desktop in Firewall</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Enable-NetFirewallRule -DisplayGroup 'Remote Desktop'"</CommandLine>
                </SynchronousCommand>

                <!-- Install Chocolatey -->
                <SynchronousCommand wcm:action="add">
                    <Order>14</Order>
                    <Description>Install Chocolatey</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Set-ExecutionPolicy Bypass -Scope Process -Force; [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))"</CommandLine>
                </SynchronousCommand>

                <!-- OpenSSH Setup -->
                <SynchronousCommand wcm:action="add">
                    <Order>15</Order>
                    <Description>Install OpenSSH Server</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0"</CommandLine>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>16</Order>
                    <Description>Configure OpenSSH Service</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Service sshd; Set-Service -Name sshd -StartupType 'Automatic'"</CommandLine>
                </SynchronousCommand>
                <!-- Redundant with the firewall being disabled, kept in case it's re-enabled later -->
                <SynchronousCommand wcm:action="add">
                    <Order>17</Order>
                    <Description>Allow SSH in Firewall</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "if (!(Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue)) { New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server (sshd)' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 }"</CommandLine>
                </SynchronousCommand>

                <!-- App Installs. Full path to choco.exe, NOT bare "choco" - see CLAUDE.md -->
                <SynchronousCommand wcm:action="add">
                    <Order>18</Order>
                    <Description>Install Git</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "C:\ProgramData\chocolatey\bin\choco.exe install git -y"</CommandLine>
                </SynchronousCommand>

                <!-- pgr2-recomp toolchain: CMake 3.20+, Python 3.10+ w/ capstone, VS2022
                     with the C++ (not .NET) desktop workload - see CLAUDE.md -->
                <SynchronousCommand wcm:action="add">
                    <Order>19</Order>
                    <Description>Install CMake</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "C:\ProgramData\chocolatey\bin\choco.exe install cmake -y"</CommandLine>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>20</Order>
                    <Description>Install Python</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "C:\ProgramData\chocolatey\bin\choco.exe install python -y"</CommandLine>
                </SynchronousCommand>
                <!-- python/pip's install path is version-specific (chocolatey's "python"
                     meta-package tracks the latest 3.x), so re-read PATH from the registry
                     here rather than guessing a path, same underlying issue as choco.exe
                     above but a full path isn't reliable for this one - see CLAUDE.md -->
                <SynchronousCommand wcm:action="add">
                    <Order>21</Order>
                    <Description>Install capstone (pip)</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User'); python -m pip install capstone"</CommandLine>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>22</Order>
                    <Description>Install Visual Studio 2022 Professional</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "C:\ProgramData\chocolatey\bin\choco.exe install visualstudio2022professional -y"</CommandLine>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>23</Order>
                    <Description>Install VS2022 Desktop C++ Workload</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "C:\ProgramData\chocolatey\bin\choco.exe install visualstudio2022-workload-nativedesktop -y"</CommandLine>
                </SynchronousCommand>

                <!-- Disable the pagefile entirely - dev VM, disk space over crash-dump
                     capability, see CLAUDE.md -->
                <SynchronousCommand wcm:action="add">
                    <Order>24</Order>
                    <Description>Disable Pagefile</Description>
                    <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "$cs = Get-CimInstance Win32_ComputerSystem; $cs.AutomaticManagedPagefile = $false; Set-CimInstance -InputObject $cs; Get-CimInstance Win32_PageFileSetting | Remove-CimInstance -ErrorAction SilentlyContinue"</CommandLine>
                </SynchronousCommand>
            </FirstLogonCommands>
        </component>
    </settings>
</unattend>